# Copy to .env for local development. Never commit the real .env.

# SQLite database (in production append ?connection_limit=1 — see README "Deploying (Railway)")
DATABASE_URL=file:./db/custom.db

# Session signing secret. REQUIRED in production: openssl rand -hex 32
# (unset falls back to a public dev secret in development, fails closed in production)
AUTH_SECRET=

# Canonical public origin, REQUIRED in production since Task 30D:
# email sign-in/confirmation links are built from it, and publicOrigin
# fails closed (500) without it. Format: https://host — no path/credentials.
# APP_URL=https://etikettkontroll-production.up.railway.app

# Optional Google/Facebook sign-in (UI degrades gracefully when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Optional label auto-fill — Google Gemini (free tier). Any OpenAI-compatible
# vision endpoint works; with plain OpenAI, omit BASE_URL/MODEL (gpt-4o-mini).
# OCR_API_KEY=
# OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OCR_MODEL=gemini-2.5-flash

# Optional magic-link email delivery (unset = dev mode returns the link in the API response)
# RESEND_API_KEY=
# MAIL_FROM=

# Set to 0 to disable API rate limiting (on by default; auto-disabled under bun test)
# EK_RATE_LIMIT=1
